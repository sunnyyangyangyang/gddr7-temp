# generated by codegen
# (moved to .git/info/exclude: rust-analyzer refuses to load git-ignored files via include!)


# kernel build artifacts (M=$(PWD) mode, akmod standard)
*.o
*.ko
*.mod
*.mod.c
.*.cmd
..*.cmd
.module-common.o
Module.symvers
modules.order

# local manual build dir (optional, for testing outside of spec)
build/

# research scratch / reference material (not part of the driver)
.ref/
.ref-rust/
.scratch/

# rust-analyzer: generated project file + kernel source clone for IDE
# (prebuilt RPM trees have no rust/ sources; `make ide` manages both)
rust-project.json
.ide-src/
